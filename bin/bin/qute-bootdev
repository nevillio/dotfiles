#!/bin/bash
TMPFILE="/tmp/bootdev-code.py"

qutebrowser ':jseval --world main navigator.clipboard.writeText(Array.from(document.activeElement.children).map(c => c.textContent).join("\n"))'
sleep 0.5

wl-paste > "$TMPFILE"
if [ ! -s "$TMPFILE" ]; then
    notify-send "Boot.dev Editor" "Failed to get content from editor"
    exit 1
fi

kitty -e nvim -f "$TMPFILE"

cat "$TMPFILE" | wl-copy
qutebrowser ":jseval --world main navigator.clipboard.readText().then(t => { document.activeElement.textContent = t; document.activeElement.dispatchEvent(new Event('input', {bubbles: true})); })"
